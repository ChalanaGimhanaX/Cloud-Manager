# Bot Configuration
BOT_TOKEN=your_discord_bot_token
DASHBOARD_URL=http://localhost:5000

# Database
DB_PATH=cloud_manager.db

# Dashboard
SECRET_KEY=replace-with-your-own-random-session-secret
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# IMPORTANT: This exact redirect URI must be added in your Discord Developer Portal
# under OAuth2 -> Redirects. It must match EXACTLY (including http/https).
DISCORD_REDIRECT_URI=http://localhost:5000/callback
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DEBUG=true

# Admin IDs (comma-separated)
SUPERADMIN_IDS=
